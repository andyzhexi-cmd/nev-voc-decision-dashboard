# 智评车行 · 决策看板 — 密钥模板（Streamlit secrets）
#
# 当前版本的产品是「本地数据 + 论文基准」驱动，不需要任何外部凭据，
# 因此线上部署时这一节可以留空。将来接企业数据源（数据库 / 对象存储 / 单点登录）时，
# 按下面的形式补充，然后：
#   * 本机调试：把本文件复制为 产品实现/.streamlit/secrets.toml（已被 .gitignore 忽略）
#   * 线上部署：Streamlit Community Cloud → App → Settings → Secrets 里粘贴同样内容
#   * 代码里用 st.secrets["xxx"] 读取，绝不把密钥写进仓库

# [postgres]
# host = "db.internal.example.com"
# port = 5432
# database = "voice_of_customer"
# user = "readonly"
# password = "此处填真实口令"

# [sso]
# provider = "azure-ad"
# tenant_id = "..."
# client_id = "..."
# client_secret = "..."
